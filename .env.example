# Required
ANTHROPIC_API_KEY=sk-ant-your-actual-key-here
MONGODB_URI=mongodb+srv://user:password@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority

# Optional — access control (see README "Security" section)
# If unset, the server only accepts requests from localhost.
# Set this to allow remote/deployed access, and send it as the
# `x-app-secret` header from your own client.
APP_SHARED_SECRET=

# Optional — only needed if you host the frontend on a different origin
# than this server. Leave unset for normal local use.
ALLOWED_ORIGIN=

PORT=3000
